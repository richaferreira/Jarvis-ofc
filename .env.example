# Copie para .env. Nunca envie o .env ao GitHub.
# Padrão local: instale Ollama e execute ollama pull qwen3:8b.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OpenAI: LLM_PROVIDER=openai; LLM_MODEL=<modelo disponível com tools>
# OPENAI_API_KEY=
# Gemini: LLM_PROVIDER=gemini; LLM_MODEL=<modelo disponível com tools>
# GOOGLE_API_KEY=
LLM_MAX_TOKENS=1024
REQUEST_TIMEOUT=30
TURN_TIMEOUT=120
MAX_TOOL_ROUNDS=3
MAX_TOOL_CALLS=4
MAX_INPUT_CHARS=4000
TIMEZONE=America/Sao_Paulo
DATA_DIR=data
LOG_LEVEL=INFO

MEMORY_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEMORY_TOP_K=3
# Limite de busca por fonte; após esse prazo, responde sem essa memória.
MEMORY_RECALL_TIMEOUT=1.5
HISTORY_TURNS=8
HISTORY_CHARS=12000
MAX_SESSIONS=64
SESSION_TTL=3600

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_LANGUAGE=pt
# AUDIO_DEVICE=0
AUDIO_SAMPLE_RATE=16000
SPEECH_THRESHOLD=0.015
SILENCE_SECONDS=1.2
LISTEN_TIMEOUT=10
MAX_RECORD_SECONDS=20
TTS_PROVIDER=edge
EDGE_VOICE=pt-BR-AntonioNeural
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_MAX_CHARS=3000
TTS_CACHE_MB=128
TTS_CACHE_TTL=604800

# Configure uma URL confiável. Sem redirects e sem URLs fornecidas pelo modelo.
# HOME_ASSISTANT_URL=http://192.168.1.10:8123
# HOME_ASSISTANT_TOKEN=
# HOME_ACTIONS={"ligar_sala":{"description":"Ligar a luz da sala","domain":"light","service":"turn_on","entity_ids":["light.sala"]}}
# Alternativa de webhook (o ID funciona como segredo):
# HOME_ACTIONS={"cena_noite":{"description":"Ativar cena noturna","webhook_id":"SUBSTITUA_PELO_ID_REAL"}}
ACTION_TTL=120

API_HOST=127.0.0.1
API_PORT=8000
# Gere: python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_TOKEN=

# Gateway OmniRoute: cadastre as chaves dos provedores no painel do gateway.
# LLM_PROVIDER=omniroute
# LLM_MODEL=<ID exato de modelo ou combo configurado no OmniRoute>
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
# OMNIROUTE_API_KEY=<chave do gateway; diferente de API_TOKEN do Jarvis>
